# ==============================================================================
# ALINA — .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Build Outputs & Cache
dist/
.next/
out/
build/
target/
src-tauri/target/
.tauri/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Monorepo Turborepo
.turbo/

# Environment Configurations & Local Secrets
.env
.env.local
.env.*.local
*.env
*.env.local
credentials.json
*.pem
*.key
*.cert
id_rsa*

# Runtime Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# Operating System Metadata
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage Artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# SurrealDB Local Data & SQLite Fallbacks
surreal-data/
*.db
*.db-journal
*.db-wal

# Temporary IDE / Agent Media & Scratch Storage
.tempmediaStorage/
.test-sandbox/
scratch/tmp/
*.tmp

# Editor Settings (preserve team recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

