# ==============================================================================
# ALINA — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (or '.env.local') in the project root.
# 2. Never commit '.env' or any file containing real API keys/credentials to Git.
# 3. In production, sensitive API keys should be provisioned through secure secrets
#    managers or the native OS Keyring.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. SurrealDB Connection
# ------------------------------------------------------------------------------
# When running on the host machine connecting to local/dockerized SurrealDB:
SURREAL_ENDPOINT=http://127.0.0.1:8000/rpc
# When running inside Docker containers on the 'alina-network' bridge:
# SURREAL_ENDPOINT=http://surrealdb:8000/rpc

SURREAL_NAMESPACE=alina
SURREAL_DATABASE=main
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. Docker Compose Orchestration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=alina
DOCKER_SURREALDB_PORT=8000
DOCKER_SERVER_PORT=3000

# ------------------------------------------------------------------------------
# 4. Model Providers (Zero Real Secrets — Safe Placeholders Only)
# ------------------------------------------------------------------------------
# Production models are secured via OS Keyring; fill in for local agent evaluation:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama endpoint (use host.docker.internal when containerized):
OLLAMA_BASE_URL=http://localhost:11434
# Inside Docker container:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 5. Multimodal Voice Interaction
# ------------------------------------------------------------------------------
VOICE_STT_ENGINE=web-speech
VOICE_TTS_ENGINE=web-speech

# ------------------------------------------------------------------------------
# 6. Security Sandbox & Path Containment
# ------------------------------------------------------------------------------
# Comma-separated list of additional allowed absolute directory paths outside workspace:
ALINA_SANDBOX_ALLOWED_ROOTS=

# ------------------------------------------------------------------------------
# 7. Observability & Telemetry
# ------------------------------------------------------------------------------
ALINA_LOG_LEVEL=info
ALINA_TELEMETRY_ENABLED=true

# ------------------------------------------------------------------------------
# 8. High-Reliability Task Execution Engine & Checkpointing
# ------------------------------------------------------------------------------
ALINA_TASK_TIMEOUT_MS=300000
ALINA_STEP_TIMEOUT_MS=60000
ALINA_PLANNING_TIMEOUT_MS=30000
ALINA_RETRY_TIMEOUT_MS=30000
ALINA_MAX_RETRIES=3
ALINA_RETRY_INITIAL_DELAY_MS=1000
ALINA_RETRY_BACKOFF_MULTIPLIER=2
ALINA_CHECKPOINT_PRUNE_LIMIT=100

# ------------------------------------------------------------------------------
# 9. Adaptive Learning & Personal Memory
# ------------------------------------------------------------------------------
ALINA_LEARNING_AUTO_EXTRACT=true
ALINA_LEARNING_MIN_CONFIDENCE=0.7
ALINA_MEMORY_VECTOR_DIMENSIONS=1536
