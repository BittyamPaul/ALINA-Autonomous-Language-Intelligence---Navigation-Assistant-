{
  "name": "@alina/database",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/scripts/init-db.ts",
    "db:seed": "tsx src/scripts/init-db.ts --seed"
  },
  "dependencies": {
    "@alina/shared": "workspace:*",
    "surrealdb": "^1.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@alina/config": "workspace:*",
    "tsup": "^8.3.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
