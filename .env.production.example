# ==============================================================================
# ALINA — Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# ARCHITECTURAL NOTICE:
# ALINA employs a decoupled, multi-tier production architecture:
# 1. Desktop Client: Distributed as native signed binaries (Tauri v2 + Next.js).
# 2. Backend API / Headless Agent Server: Deployed in containerized VPC workloads.
# 3. SurrealDB Cluster: Deployed on private, isolated VPC subnets with NVMe SSDs.
# 4. MCP Sandboxes: Sandboxed containerized workers with strict PathJail containment.
#
# SECURITY DIRECTIVE:
# - NEVER commit real secrets, private keys, or credentials to version control.
# - In production, secrets must be injected at runtime via an authorized secrets
#   manager (e.g., AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager, Infisical).
# - Desktop clients retrieve credentials on-demand from OS Keyring / Windows DPAPI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_APP_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 2. SurrealDB Multi-Tenant / Production Cluster
# ------------------------------------------------------------------------------
# Production instances MUST use TLS/WSS or a private VPC internal DNS hostname.
# Public exposure without an ingress proxy or VPN is strictly prohibited.
SURREAL_ENDPOINT=https://db.internal.alina.vpc:8000/rpc
SURREAL_NAMESPACE=alina_prod
SURREAL_DATABASE=alina_primary
# Credentials provisioned via Vault / AWS Secrets Manager / KMS at container launch:
SURREAL_USERNAME=alina_app_runner
SURREAL_PASSWORD=${SURREAL_PROD_PASSWORD}

# Connection pool and retry policy
SURREAL_MAX_RETRIES=5
SURREAL_RETRY_DELAY_MS=1000

# ------------------------------------------------------------------------------
# 3. Secure Model Providers (Injected via Secrets Vault)
# ------------------------------------------------------------------------------
# In headless/backend production deployments, keys are injected as ephemeral env vars.
# On client desktop builds, credentials are stored in the user's OS Keychain.
ANTHROPIC_API_KEY=${SECRET_ANTHROPIC_API_KEY}
OPENAI_API_KEY=${SECRET_OPENAI_API_KEY}
GEMINI_API_KEY=${SECRET_GEMINI_API_KEY}

# Self-hosted / VPC local inference endpoints (Ollama / vLLM / Triton):
OLLAMA_BASE_URL=https://inference.internal.alina.vpc:11434

# ------------------------------------------------------------------------------
# 4. Production Logging & Telemetry
# ------------------------------------------------------------------------------
# Structured JSON logging for cloud aggregators (Datadog, Grafana Loki, CloudWatch)
LOG_FORMAT=json
ALINA_LOG_LEVEL=info
ALINA_SERVICE_NAME=alina-api-production
ALINA_TELEMETRY_ENABLED=true
ALINA_TRACE_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# 5. Security Gates, Sandbox & CORS Policy
# ------------------------------------------------------------------------------
# Strict CORS allowed origins (Tauri native schema and authorized origins only)
ALINA_CORS_ALLOWED_ORIGINS=tauri://localhost,http://localhost:3000,https://app.alina.internal

# Absolute root paths permitted by PathJail in production agent runner
ALINA_SANDBOX_ALLOWED_ROOTS=/var/data/alina-sandbox,/tmp/alina-ephemeral

# Human-In-The-Loop safety gate enforcement ('true' mandatory in production)
ALINA_ENFORCE_HITL=true
ALINA_APPROVAL_TIMEOUT_MS=300000

# ------------------------------------------------------------------------------
# 6. Database Automated Backup & Snapshot Config
# ------------------------------------------------------------------------------
# Target S3/GCS bucket for encrypted off-site database snapshots
BACKUP_STORAGE_BUCKET=s3://alina-production-cold-backups
BACKUP_RETENTION_DAYS=30
BACKUP_GPG_RECIPIENT_KEY=security-ops@alina.internal
